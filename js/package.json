{
  "name": "jupyterlab-iframe",
  "version": "0.5.0",
  "description": "IFrame widgets for JupyterLab",
  "repository": "git@github.com:timkpaine/jupyterlab_iframe.git",
  "author": "the jupyterlab-iframe authors <t.paine154@gmail.com>",
  "license": "Apache-2.0",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension"
  ],
  "main": "lib/index.js",
  "files": [
    "lib/**/*.{d.ts,eot,gif,html,jpg,js,js.map,json,png,svg,woff2,ttf}",
    "style/**/*.css"
  ],
  "jupyterlab": {
    "extension": "lib/index.js",
    "outputDir": "../jupyterlab_iframe/labextension",
    "discovery": {
      "server": {
        "base": {
          "name": "jupyterlab_iframe"
        },
        "managers": [
          "pip"
        ]
      }
    }
  },
  "scripts": {
    "build:babel": "babel src/ --source-maps --out-dir lib/",
    "build:extension": "mkdirp ../jupyterlab_iframe/extension/ && cpy --flat 'src/extension/*' '../jupyterlab_iframe/extension/'",
    "build:nbextension": "mkdirp ../jupyterlab_iframe/nbextension/static/ && cpy --flat 'src/notebook.js' '../jupyterlab_iframe/nbextension/static/'",
    "build:labextension": "rimraf ../jupyterlab_iframe/labextension && jupyter labextension build .",
    "build": "pnpm clean && pnpm build:babel && pnpm build:extension && pnpm build:labextension && pnpm build:nbextension",
    "clean": "rimraf lib",
    "fix": "oxlint --fix src/ tests/ && oxfmt --write \"src/**/*.js\" \"tests/**/*.js\"",
    "lint": "oxlint src/ tests/ && oxfmt --check \"src/**/*.js\" \"tests/**/*.js\"",
    "preinstall": "npx only-allow pnpm",
    "prepublishOnly": "pnpm run build",
    "test": "jest --coverage --collectCoverageFrom=src/*.{js}"
  },
  "dependencies": {
    "@jupyterlab/application": "^4.5.7",
    "@jupyterlab/apputils": "^4.6.7",
    "@jupyterlab/coreutils": "^6.5.7",
    "@jupyterlab/launcher": "^4.5.7",
    "@jupyterlab/notebook": "^4.5.7",
    "@jupyterlab/services": "^7.5.10",
    "@lumino/disposable": "^2.1.5",
    "@lumino/widgets": "^2.7.5",
    "requests-helper": "^0.1.5"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.3",
    "@jupyterlab/builder": "^4.5.10",
    "babel-jest": "^30.4.1",
